# ── Required ─────────────────────────────────────────────────────────────────
# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fenlark
# Optional: URI used only for migrations. On Supabase use the "Session pooler" (port 5432);
# its "Direct connection" is IPv6-only on the free plan and unreachable from Vercel builds.
MIGRATION_DATABASE_URL=
# Public URL of the app — used in email links and payment-gateway callbacks.
APP_URL=http://localhost:3000
# The first sign-in with this address creates the owner account.
OWNER_EMAIL=you@fenlark.in

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Without a key, emails (including sign-in codes) are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Fenlark Billing <billing@fenlark.in>

# ── File storage (logo / signature) ──────────────────────────────────────────
# Supabase Storage in production; local .data/uploads when unset.
SUPABASE_URL=
# Secret key (sb_secret_…) or legacy service_role key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fenlark
# STORAGE_DRIVER=local

# ── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts payment-gateway secrets.
ENCRYPTION_KEY=
# Random string; Vercel Cron sends it as a bearer token to /api/cron/daily.
CRON_SECRET=
